<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>ERP.Auth.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除子專案目錄，避免 obj/ 下的自動產生檔案被雙重引入 -->
    <Compile Remove="ERP.Auth.Common.Tests\**" />
    <Content Remove="ERP.Auth.Common.Tests\**" />
    <EmbeddedResource Remove="ERP.Auth.Common.Tests\**" />
    <None Remove="ERP.Auth.Common.Tests\**" />
    <Compile Remove="ERP.Launcher\**" />
    <Content Remove="ERP.Launcher\**" />
    <EmbeddedResource Remove="ERP.Launcher\**" />
    <None Remove="ERP.Launcher\**" />
    <Compile Remove="ERP.Gateway\**" />
    <Content Remove="ERP.Gateway\**" />
    <EmbeddedResource Remove="ERP.Gateway\**" />
    <None Remove="ERP.Gateway\**" />
    <Compile Remove="ERP.ServiceDefaults\**" />
    <Content Remove="ERP.ServiceDefaults\**" />
    <EmbeddedResource Remove="ERP.ServiceDefaults\**" />
    <None Remove="ERP.ServiceDefaults\**" />
    <Compile Remove="ERP.AppHost\**" />
    <Content Remove="ERP.AppHost\**" />
    <EmbeddedResource Remove="ERP.AppHost\**" />
    <None Remove="ERP.AppHost\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.9.0" />
  </ItemGroup>

</Project>

# 鼎新 ERP 作業轉換模板

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{cshtml,html}]
indent_size = 4

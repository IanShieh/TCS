@{
    ViewData["Title"] = "新增證照";
}
<h2>新增證照</h2>
<div class="row">
    <div class="col-md-6">
        <form id="create-form">
            <div class="mb-3">
                <label class="form-label">證照類別 <span class="text-danger">*</span></label>
                <input type="text" id="LicenseType" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">說明 <span class="text-danger">*</span></label>
                <input type="text" id="Description" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">對應大類</label>
                <input type="text" id="Category" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">所需時數</label>
                <input type="number" id="Hours" class="form-control" min="0" />
            </div>
            <div class="mb-3">
                <label class="form-label">年數</label>
                <input type="number" id="Years" class="form-control" min="0" />
            </div>
            <div id="error-msg" class="alert alert-danger d-none"></div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">儲存</button>
                <a href="/License" class="btn btn-secondary">取消</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script>
$('#create-form').on('submit', async function (e) {
    e.preventDefault();
    const body = {
        LicenseType: $('#LicenseType').val().trim(),
        Description: $('#Description').val().trim(),
        Category: $('#Category').val().trim() || null,
        Hours: $('#Hours').val() !== '' ? parseInt($('#Hours').val()) : null,
        Years: $('#Years').val() !== '' ? parseInt($('#Years').val()) : null
    };
    const base = window.ERP_BASE || '';
    const res = await fetch(base + '/api/licenses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
    });
    if (res.status === 201) {
        window.location.href = base + '/License';
    } else {
        const err = await res.json();
        $('#error-msg').text(err.message || '儲存失敗').removeClass('d-none');
    }
});
</script>
}
